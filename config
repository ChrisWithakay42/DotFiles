# --- Shell & Terminal Environment ---
term = xterm-256color
command = /bin/zsh --login -c "/opt/homebrew/bin/tmux attach || /opt/homebrew/bin/tmux"

# --- Window & Styling ---
window-decoration = auto
background-opacity = 0.65
background-blur-radius = 20
window-padding-x = 8
window-padding-y = 8

# --- Font Settings ---
font-family = "JetBrainsMono Nerd Font"
font-size = 12.0

# --- Scrollback & Battery Optimization ---
scrollback-limit = 10000
cursor-style-blink = false

# --- Keybindings ---
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# --- Colors (Gruvbox Dark Explicit Hex) ---
background = #282828
foreground = #ebdbb2
selection-background = #665c54
selection-foreground = #ebdbb2
cursor-color = #ebdbb2
cursor-text = #282828

palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
